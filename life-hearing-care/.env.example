# Patient Portal - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# SUPABASE CONFIGURATION (Required)
# ============================================
# Get these from your Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ============================================
# SECURITY (Required)
# ============================================
# 32-character encryption key for auth token storage
# Generate with: openssl rand -hex 32
VITE_API_SECRET=your-32-character-encryption-key-here

# ============================================
# STAFF ACCESS (Required for Admin Routes)
# ============================================
# Email address allowed to access /admin routes on patient portal
VITE_STAFF_EMAIL=admin@yourclinic.com

# ============================================
# ANALYTICS (Optional)
# ============================================
# Vercel Analytics ID or other analytics provider
VITE_ANALYTICS_ID=your-analytics-id

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
# VITE_ENABLE_ONLINE_PAYMENTS=false
# VITE_ENABLE_TELEMEDICINE=false
# VITE_ENABLE_HOME_VISITS=true